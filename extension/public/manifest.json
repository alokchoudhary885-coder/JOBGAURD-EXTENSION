{
  "manifest_version": 3,
  "name": "JobGuard — Know The Risk Before You Apply",
  "version": "2.0.0",
  "description": "Deterministic fraud risk analysis and employer verification for LinkedIn, Internshala, Indeed, and online career listings.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://api.jobguard.app/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "JobGuard — Risk Analyzer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.internshala.com/*",
        "https://*.indeed.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
